# ── secrets (NEVER commit) ───────────────────────────────────────────────────
.env
.env.*
!.env.example
# Local compose with baked-in secrets — never commit or share
docker/compose.prod.yaml

# ── dependencies / build artifacts ───────────────────────────────────────────
node_modules/
build/
.svelte-kit/
dist/

# ── libraries & temp data (user content) ─────────────────────────────────────
music/
# Local dev library (dev instance only; the deployment serves /music)
.dev-library/
.tmp/
logs/

# ── caches / coverage ────────────────────────────────────────────────────────
coverage/
*.log
.cache/

# ── os noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
opencode.jsonc

# session cookie jars and scratch files — these carry live session tokens
c*.txt
cookies*.txt
