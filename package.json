{
	"name": "navisync",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"description": "Self-hosted, privacy-first Navidrome download & synchronization hub (Phase 1: Node monolith)",
	"engines": {
		"bun": ">=1.1"
	},
	"scripts": {
		"dev": "bunx --bun vite dev",
		"build": "bunx --bun vite build",
		"start": "bun ./build/index.js",
		"check": "bun svelte-kit sync && bunx --bun svelte-check --tsconfig ./tsconfig.json",
		"lint": "bunx eslint . --max-warnings 0",
		"format": "bunx prettier --write .",
		"format:check": "bunx prettier --check .",
		"test": "bunx vitest run",
		"test:watch": "bunx vitest",
		"db:create": "bun scripts/create-db.ts",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"db:seed": "bun scripts/seed.ts",
		"smoke": "bash scripts/smoke.sh"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.0",
		"@hugeicons/core-free-icons": "^4.3.5",
		"@hugeicons/svelte": "^1.1.5",
		"@node-rs/argon2": "^2.0.2",
		"better-auth": "^1.7.0",
		"blowfish-js": "^1.0.0",
		"dotenv": "^17.2.0",
		"drizzle-orm": "^0.45.2",
		"flac-metadata": "^0.1.0",
		"music-metadata": "^11.0.0",
		"node-id3": "^0.2.9",
		"pg": "^8.16.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.0",
		"@sveltejs/adapter-node": "^5.3.0",
		"@sveltejs/kit": "^2.27.0",
		"@sveltejs/vite-plugin-svelte": "^6.1.0",
		"@tailwindcss/vite": "^4.1.0",
		"@types/node": "^24.0.0",
		"@types/pg": "^8.15.0",
		"archiver": "^8.0.0",
		"drizzle-kit": "^0.31.0",
		"eslint": "^9.30.0",
		"eslint-config-prettier": "^10.1.0",
		"eslint-plugin-svelte": "^3.11.0",
		"prettier": "3.6.2",
		"prettier-plugin-svelte": "3.5.2",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.36.0",
		"svelte-check": "^4.2.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.8.0",
		"typescript-eslint": "^8.35.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.0"
	}
}
