# ──────────────────────────────────────────────────────────────────────────────
# NaviSync environment — copy to .env and fill in. NEVER commit .env.
# Generate secrets with: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL 16+ connection string (required)
DATABASE_URL=postgresql://user:password@host:5432/postgres

# 32+ byte secret: signs sessions AND encrypts stored credentials (AES-256-GCM) (required)
APP_SECRET=change-me-generate-with-openssl-rand-hex-32

# Public base URL of this app (used for auth cookies/callbacks)
BETTER_AUTH_URL=http://localhost:7158
# Canonical origin served by adapter-node. Must match BETTER_AUTH_URL.
# Required under the Bun runtime and behind reverse proxies (see docs/deployment.md).
ORIGIN=http://localhost:7158

# Extra origins allowed to call the API (comma-separated, optional)
# TRUSTED_ORIGINS=https://navisync.example.com

# HTTP server
PORT=7158
HOST=0.0.0.0

# Music library root — must match the directory Navidrome scans
MUSIC_LIBRARY_DIR=./music

# Scratch space for in-flight downloads (cleaned automatically)
MUSIC_TMP_DIR=./.tmp

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Set secure cookies (enable ONLY when serving over HTTPS)
USE_SECURE_COOKIES=false

# Deezer provider credentials
# Used once to derive an ARL session (stored AES-256-GCM encrypted in the DB).
# QUOTE values containing $ or # — e.g. DEEZER_PASSWORD='pa$$word'
# DEEZER_EMAIL=you@example.com
# DEEZER_PASSWORD=yourpassword

# Optional: external dzmedia-compatible resolver fallback (GET/POST /get_url).
# Leave empty to always decrypt locally (privacy-preserving default).
# DEEZER_RESOLVER_URL=
# Multipart upload cap (adapter-node) — audio files
BODY_SIZE_LIMIT=500M
